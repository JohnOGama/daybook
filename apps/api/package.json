{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/main.js",
    "dev": "tsx watch --env-file=.env src/main.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "fitness:import-foods": "tsx --env-file=.env src/scripts/import-usda-foods.ts",
    "fitness:import-exercises": "tsx --env-file=.env src/scripts/import-exercises.ts"
  },
  "dependencies": {
    "@dbml/core": "12.0.0",
    "@google/genai": "^3.2.0",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "lib0": "0.2.119",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.37.0",
    "rxjs": "^7.8.2",
    "ws": "8.22.1",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@nestjs/testing": "^12.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "22",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "8.18.2",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
